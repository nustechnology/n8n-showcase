# === PostgreSQL ===
POSTGRES_USER=n8n-showcase
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# === Backend (NestJS) ===
# Connection string for Prisma — postgres is the docker-compose service name.
DATABASE_URL="postgresql://n8n-showcase:${POSTGRES_PASSWORD}@postgres:5432/postgres"

CLERK_ISSUER="https://your-instance.clerk.accounts.dev"
CLERK_WEBHOOK_SECRET="whsec_..."
CLERK_SECRET_KEY="sk_..."

# 32 bytes, base64: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# Publicly reachable base URL of the backend (needed for Shopify/Zoho OAuth redirects).
# In local dev, use a tunnel URL (ngrok); in production, use the real domain.
APP_BASE_URL="https://your-tunnel.example.com"

# Where the frontend runs — http://localhost:3001 in local dev.
FRONTEND_URL="http://localhost:3001"

# Shared secret between BE and n8n — same value on both sides.
# Generate with: openssl rand -hex 32
N8N_INTERNAL_TOKEN=""

# === Optional integrations ===
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_SCOPES="read_orders,read_fulfillments,write_fulfillments,read_locations,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders"
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""

# === Frontend (Next.js) ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_..."
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/create-workspace"
NEXT_PUBLIC_GEOAPIFY_API_KEY=""

# === n8n ===
# Backend's URL to reach n8n — http://n8n:5678 in Docker, http://localhost:5680 locally.
N8N_BASE_URL="http://localhost:5680"

# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=""
N8N_API_KEY=""
