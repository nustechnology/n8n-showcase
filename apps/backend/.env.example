# Single Postgres role, full privileges — this project isn't using
# database-level Row-Level Security, so there's no separate restricted
# connection. Tenant isolation is application-level only: every
# tenant-scoped query in the codebase must filter by tenantId explicitly.
DATABASE_URL="postgresql://aec:CHANGE_ME@localhost:5432/postgres"

# Clerk's frontend API origin, e.g. https://your-app.clerk.accounts.dev
# (production) or the *.accounts.dev value shown in the Clerk dashboard for
# this instance. JWKS is fetched from `${CLERK_ISSUER}/.well-known/jwks.json`
# and re-verified against on every request — see ClerkVerifierService.
CLERK_ISSUER="https://your-instance.clerk.accounts.dev"

# Signing secret for the Clerk webhook endpoint (Clerk dashboard → Webhooks
# → your endpoint → Signing Secret, starts with "whsec_"). Verified via
# Svix in ClerkWebhookController — this is what provisions tenants/users/
# memberships from organization.*, user.*, and organizationMembership.*
# events, instead of the manual SQL insert.
CLERK_WEBHOOK_SECRET="whsec_..."

# Clerk dashboard → API Keys → Secret Key. Used by ClerkBackendService to
# call *out* to Clerk's Backend API (create invitations, change a member's
# role, remove a member) — distinct from CLERK_ISSUER/CLERK_WEBHOOK_SECRET,
# which only ever verify something Clerk sent *us*.
CLERK_SECRET_KEY="sk_..."

# 32 bytes, base64 — encrypts third-party API keys/tokens (Shopify, Resend)
# before they're stored (CredentialsService, AES-256-GCM). Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=""

# Shopify Partner app credentials (partners.shopify.com → your app → Client
# credentials). SHOPIFY_SCOPES is what the OAuth consent screen requests —
# read_orders is all this app needs today.
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
SHOPIFY_SCOPES="read_orders"

# Zoho API Console (api-console.zoho.com) → Server-based Application →
# Client ID/Secret. Zoho Inventory has no static-key mode, only real OAuth2
# — ZohoInventoryAdapter uses these to exchange the connect-flow code and to
# refresh an expired access token (lazy, on a 401 from checkInventory()).
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""

# Publicly reachable base URL of *this* backend — builds the Shopify/Zoho
# OAuth redirect_uris and the webhook address Shopify calls. In local dev
# this is a tunnel URL (ngrok or similar), not localhost — neither Shopify
# nor Zoho's servers can reach your machine directly. Update each app's
# redirect URI to match: `${APP_BASE_URL}/integrations/{shopify,zoho_inventory}/callback`.
APP_BASE_URL="https://your-tunnel.example.com"

# Base URL of the Next.js frontend — where a tenant lands after completing
# (or failing) the Shopify OAuth flow.
FRONTEND_URL="http://localhost:3001"

# Shared secret authenticating n8n's callbacks into POST/PATCH /internal/*
# (InternalAuthGuard) — the same raw value n8n stores as its "Backend
# Internal Token" Header Auth credential, sent as `Authorization: Bearer
# <value>`. Generate with: openssl rand -hex 32
N8N_INTERNAL_TOKEN=""

# Where n8n itself listens (N8nOrchestratorService POSTs
# ${N8N_BASE_URL}/webhook/order-received to kick off the order-validation
# workflow after a Shopify order comes in). The n8n repo's docker-compose
# maps this to localhost:5680 in local dev.
N8N_BASE_URL="http://localhost:5680"

PORT=3000
