{
  "name": "@n8n-showcase/backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsc -p prisma/tsconfig.seed.json && node dist-prisma/seed.js",
    "prisma:studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "5.22.0",
    "dotenv": "^16.6.1",
    "jose": "^5.9.6",
    "nestjs-cls": "^6.2.1",
    "opossum": "^8.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svix": "^1.96.1",
    "undici": "^8.7.0",
    "zod": "^4.4.3",
    "@n8n-showcase/shared-schemas": "*"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/node-fetch": "^2.6.13",
    "@types/opossum": "^8.1.9",
    "jest": "^29.7.0",
    "nock": "^14.0.16",
    "prisma": "5.22.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@n8n-showcase/shared-schemas$": "<rootDir>/../../packages/shared-schemas/src/index.ts",
      "^@n8n-showcase/shared-types$": "<rootDir>/../../packages/shared-types/src/index.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "testEnvironment": "node"
  }
}
